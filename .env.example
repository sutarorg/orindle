# Local Next.js origin. Keep APP_URL and NEXT_PUBLIC_APP_URL aligned.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (server-side service-role key must never use NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter. Model sync and generation require an API key; no provider calls run by default.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000

# Cloudflare R2 private bucket for uploads and generated assets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Dodo Payments — sandbox/test mode only. Leave live billing disabled.
DODO_ENVIRONMENT=test_mode
DODO_ENABLE_LIVE_BILLING=false
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_USD_ID=
DODO_PRICE_USD_MINOR=1499
DODO_PRODUCT_INR_ID=
DODO_PRICE_INR_MINOR=139900
# India checkout is selected only on Vercel when the trusted edge country is IN
# and the fixed INR product is configured; local/unknown country uses USD.
